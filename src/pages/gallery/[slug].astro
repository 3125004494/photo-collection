---
// 详情页 v2.0（Phase 4 升级，PRD §5）
// - 图片揭示：ScrollTrigger + clip-path inset 遮罩 wipe（once），首图 16px blur-up 占位
// - 单层视差：figure 内图片 yPercent ±8（≤±10），overflow hidden + scale 1.2 防边缘露底
// - 浏览进度：aside mono「N / M」滚动驱动（ScrollTrigger onUpdate 自带 rAF 节流）
// - 末尾 CTA：下一组 → / 无下一组时回到首页
// - 元数据修复：日期区间（2025.7.5–7.8）、theme/location 拆分显示（location 用 mono「AT —」前缀）
// 动效规范（AGENTS.md）：一切动效在 gsap.matchMedia 内；只动画 transform/opacity/filter/clip-path；
//   本页无 pin；pagehide 清理（mm.revert + ScrollTrigger.kill + 解绑监听）
import Base from "../../layouts/Base.astro";
import { albums } from "../../data/albums";

export function getStaticPaths() {
  return albums.map((a) => ({ params: { slug: a.slug }, props: { album: a } }));
}

const { album } = Astro.props;
const idx = albums.findIndex((a) => a.slug === album.slug);
const prev = idx > 0 ? albums[idx - 1] : null; // 时间线上一组（更早）
const next = idx < albums.length - 1 ? albums[idx + 1] : null;

const fmtShort = (d: string) => d.replace(/^(\d{4})-0?(\d{1,2})-0?(\d{1,2})$/, "$1.$2.$3"); // ISO → 2026.5.18
const fmtDayMonth = (d: string) => d.replace(/^\d{4}-0?(\d{1,2})-0?(\d{1,2})$/, "$1.$2"); // ISO → 5.18（区间结束日）
// 日期区间：dateEnd 存在且 ≠ dateStart → "2025.7.5–7.8"；否则单日；兜底旧字段 date
const dateLabel = album.dateStart
  ? album.dateEnd && album.dateEnd !== album.dateStart
    ? fmtShort(album.dateStart) + "–" + fmtDayMonth(album.dateEnd)
    : fmtShort(album.dateStart)
  : album.date
    ? fmtShort(album.date)
    : null;

// theme/location 拆分（schema v2）：
//   主题行 = theme → location（无 theme 时回退）→ 标题剥日期前缀兜底
//   location 行仅在 theme 与 location 并存且不同时显示（修复死 UI）
const theme = album.theme || null;
const location = album.location || null;
const legacyRest = album.title.replace(/^\d{4}\.\d{1,2}\.\d{1,2}(?:-\d{1,2})?\s*/, "").trim() || album.title;
const heading = theme || location || legacyRest;
const showLocation = !!(theme && location && location !== theme);

const seq = String(idx + 1).padStart(2, "0") + " / " + String(albums.length).padStart(2, "0"); // 影集序号
const photoCount = String(album.photos.length).padStart(2, "0"); // 进度分母
const nextTheme = next
  ? next.theme || next.location || next.title.replace(/^\d{4}\.\d{1,2}\.\d{1,2}(?:-\d{1,2})?\s*/, "").trim()
  : "";
---

<Base title={album.title + " — HAN"} nav={false}>
  <main class="relative z-20 min-h-screen bg-paper text-ink sm:fixed sm:inset-0 sm:overflow-hidden sm:bg-ink">
    <header class="mobile-gallery-bar flex items-center justify-between px-5 sm:hidden">
      <a href="/" class="inline-flex min-h-11 items-center gap-2 text-xs text-ink" aria-label="返回首页">← 返回</a>
      <a href="/" class="display-title text-xl text-ink" aria-label="HAN 首页">HAN</a>
    </header>
    <div class="relative flex min-h-screen flex-col bg-paper text-ink sm:absolute sm:inset-6 sm:min-h-0 sm:flex-row sm:overflow-hidden sm:rounded-3xl" data-sheet>
      <!-- 左侧信息栏 -->
      <aside class="flex shrink-0 flex-col justify-between gap-8 px-5 pb-8 pt-6 sm:w-80 sm:overflow-y-auto sm:p-10">
        <div>
          <!-- 序号（小字）+ 主题（宋体大字）+ 日期区间（mono 小字）+ 地点（AT 前缀） -->
          <p class="font-mono text-[0.625rem] font-medium uppercase leading-relaxed tracking-[0.14em] text-ash">{seq}</p>
          <h1 class="display-title mt-3 break-words text-4xl leading-tight sm:text-5xl sm:leading-none">{heading}</h1>
          {
            dateLabel && (
              <p class="mt-6 font-mono text-[0.625rem] font-medium uppercase leading-relaxed tracking-[0.14em] text-ash">{dateLabel}</p>
            )
          }
          {
            showLocation && (
              <p class="mt-3 font-mono text-[0.625rem] font-medium uppercase leading-relaxed tracking-[0.14em] text-ash">AT — {location}</p>
            )
          }
          {
            album.description && (
              <p class="mt-8 max-w-[30rem] text-sm leading-relaxed text-ink/70">{album.description}</p>
            )
          }
        </div>
        <div class="hidden sm:block">
          <!-- 浏览进度 N/M（滚动驱动，等宽数字防跳位） -->
          <p class="progress-num font-mono text-[0.625rem] font-medium uppercase leading-relaxed tracking-[0.14em] text-ash">
            <span data-progress-cur>01</span> / {photoCount}
          </p>
          <nav class="mt-6 flex flex-col gap-3 text-sm leading-relaxed tracking-[-0.02em]">
            {prev && <a href={"/gallery/" + prev.slug} class="text-ash transition-colors duration-300 hover:text-ink" data-nav data-dir="right">← {prev.title}</a>}
            {next && <a href={"/gallery/" + next.slug} class="text-ash transition-colors duration-300 hover:text-ink" data-nav data-dir="left">{next.title} →</a>}
          </nav>
        </div>
      </aside>

      <!-- 右侧图片流：横图段落转场 / 竖图停顿 -->
      <div class="min-w-0 flex-1 px-5 pb-10 sm:overflow-y-auto sm:px-10 sm:py-10" data-scroller tabindex="0" role="region" aria-label="照片列表">
        <p class="mb-3 font-mono text-[0.625rem] font-medium uppercase text-ash sm:hidden">01 / {photoCount} PHOTOS</p>
        <div class="mx-auto flex max-w-[56rem] flex-col" data-photos>
          {
            album.photos.map((p, i) => {
              const isPortrait = p.width < p.height;
              const cls = "gallery-figure" + (isPortrait ? " gallery-figure--tall" : " gallery-figure--wide");
              return (
                <figure class={cls} data-figure tabindex="0" role="button" aria-label={"查看第 " + (i + 1) + " 张照片"}>
                  <!-- 相纸相框：hairline 描边 + 极淡投影 + 裁切视差余量（边框不随 img 缩放被裁掉） -->
                  <div class="gallery-frame">
                    {
                      /* 首图 blur-up：16px 占位先出（filter 模糊），原图 onload 后淡入盖过 */
                      i === 0 && (
                        <img class="gallery-blur" src={p.blur} alt="" aria-hidden="true" loading="eager" decoding="async" />
                      )
                    }
                    <picture>
                      {p.avifSrcset && <source srcset={p.avifSrcset} sizes="(max-width: 639px) 88vw, 45rem" type="image/avif" />}
                      <img
                        class="gallery-img"
                        src={p.src}
                        srcset={p.srcset}
                        sizes="(max-width: 639px) 88vw, 45rem"
                      width={p.width}
                      height={p.height}
                      loading={i === 0 ? "eager" : "lazy"}
                      decoding="async"
                      style={"aspect-ratio:" + p.width + "/" + p.height}
                      alt={album.title + " " + (i + 1)}
                      onload={"this.classList.add('is-loaded')"}
                    />
                    </picture>
                  </div>
                </figure>
              );
            })
          }

          <!-- 末尾 CTA：下一组（无下一组时回到首页） -->
          <div class="py-16 text-center sm:py-20" data-cta>
            {
              next ? (
                <a href={"/gallery/" + next.slug} data-nav data-dir="left" class="group inline-flex flex-col items-center gap-4">
                  <span class="label text-ash">下一组 — {next.dateStart ? fmtShort(next.dateStart) : ""}</span>
                  <span class="display-title text-4xl text-ink transition-colors duration-300 group-hover:text-accent sm:text-5xl">{nextTheme} →</span>
                </a>
              ) : (
                <a href="/" data-close class="group inline-flex flex-col items-center gap-4">
                  <span class="label text-ash">看完了 · 回到首页</span>
                  <span class="display-title text-4xl text-ink transition-colors duration-300 group-hover:text-accent sm:text-5xl">HAN ↗</span>
                </a>
              )
            }
          </div>
        </div>
      </div>
    </div>

    <!-- 右上角关闭按钮（返回首页） -->
    <a href="/" class="circle-btn gallery-desktop-close absolute right-4 top-4 z-10 sm:right-[26px] sm:top-[26px]" aria-label="关闭并返回首页" data-close>
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 1L13 13M13 1L1 13" stroke="currentColor" stroke-width="1.5"/></svg>
    </a>
  </main>
  <div class="detail-lightbox" data-lightbox role="dialog" aria-modal="true" aria-label="照片大图" aria-hidden="true" inert>
    <button class="detail-lightbox-close" type="button" data-lightbox-close aria-label="关闭大图">×</button>
    <img data-lightbox-img alt="" decoding="async" />
    <div class="detail-lightbox-controls">
      <button type="button" data-lightbox-prev aria-label="上一张照片">←</button>
      <span data-lightbox-count aria-live="polite"></span>
      <button type="button" data-lightbox-next aria-label="下一张照片">→</button>
    </div>
  </div>
</Base>

<style>
  .mobile-gallery-bar { min-height: calc(4rem + env(safe-area-inset-top)); padding-top: env(safe-area-inset-top); border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent); }
  .gallery-desktop-close { display: none; }
  @media (min-width: 640px) { .gallery-desktop-close { display: flex; } }
  :global(html.detail-lightbox-open), :global(body.detail-lightbox-open) { overflow: hidden; }
  [data-figure] { cursor: zoom-in; }
  [data-figure]:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
  .detail-lightbox { position: fixed; inset: 0; z-index: 90; display: none; align-items: center; justify-content: center; background: var(--color-ink); color: var(--color-paper); }
  .detail-lightbox.is-open { display: flex; }
  .detail-lightbox img { display: block; max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; }
  .detail-lightbox button { min-width: 44px; min-height: 44px; color: inherit; font-size: 1.5rem; }
  .detail-lightbox button:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .detail-lightbox-close { position: absolute; top: max(1rem, env(safe-area-inset-top)); right: 1rem; z-index: 1; }
  .detail-lightbox-controls { position: absolute; right: 1rem; bottom: max(1rem, env(safe-area-inset-bottom)); left: 1rem; display: flex; align-items: center; justify-content: space-between; font: 0.75rem monospace; }
  @media (max-width: 639px) {
    [data-figure] { width: 100%; margin-block: 0 2.5rem; }
    [data-figure] :global(img.gallery-img) { max-height: none; }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const sheet = document.querySelector("[data-sheet]");
  const scroller = document.querySelector("[data-scroller]");
  const photosCol = document.querySelector("[data-photos]");
  const figures = Array.from(document.querySelectorAll("[data-figure]"));
  const progressCur = document.querySelector("[data-progress-cur]");
  const desktop = window.matchMedia("(min-width: 640px)");

  // ---- 1) 画册面板入场（app:loaded 后播；3.5s 兜底防事件丢失） ----
  let introPlayed = false;
  function playIntro() {
    if (introPlayed) return;
    introPlayed = true;
    if (sheet && desktop.matches && !reduceMotion) {
      gsap.from(sheet, { y: 56, opacity: 0, duration: 0.7, ease: "power3.out" });
    }
  }
  window.addEventListener("app:loaded", playIntro, { once: true });
  setTimeout(playIntro, 3500);

  // ---- 2) 图片揭示 + 单层视差（matchMedia 包裹；减少动态用户看到完整静态内容） ----
  const mm = gsap.matchMedia();
  mm.add("(min-width: 640px) and (prefers-reduced-motion: no-preference)", () => {
    if (!scroller) return;
    figures.forEach((fig, i) => {
      const img = fig.querySelector("img.gallery-img");
      if (!img) return;
      // 初始遮罩 + 视差余量（scale 1.2 保证 yPercent ±8 移动时边缘不露底）
      gsap.set(fig, { clipPath: "inset(0% 0% 100% 0%)" });
      gsap.set(img, { scale: 1.2 });
      // 遮罩揭示：clip-path wipe，once；首张延迟与面板入场衔接
      ScrollTrigger.create({
        trigger: fig,
        scroller: scroller,
        start: "top 94%",
        once: true,
        onEnter: () => {
          gsap.to(fig, { clipPath: "inset(0% 0% 0% 0%)", duration: 1.15, ease: "power2.inOut", delay: i === 0 ? 0.35 : 0 });
        },
      });
      // 单层视差：yPercent ±8（≤±10），scrub 跟手（只动画 transform）
      gsap.fromTo(
        img,
        { yPercent: -8 },
        {
          yPercent: 8,
          ease: "none",
          scrollTrigger: { trigger: fig, scroller: scroller, start: "top bottom", end: "bottom top", scrub: true },
        }
      );
    });

    // 末尾 CTA 淡入（once）
    const cta = document.querySelector("[data-cta]");
    if (cta) {
      ScrollTrigger.create({
        trigger: cta,
        scroller: scroller,
        start: "top 92%",
        once: true,
        onEnter: () => {
          gsap.fromTo(cta, { y: 36, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 0.9, ease: "power2.out" });
        },
      });
    }
  });

  // ---- 3) 浏览进度 N/M（滚动驱动；ScrollTrigger onUpdate 自带 rAF 节流；变更才写 DOM） ----
  let progressTrigger: { kill: () => void } | null = null;
  if (desktop.matches && scroller && photosCol && progressCur && figures.length > 1) {
    const lastFig = figures[figures.length - 1];
    const total = figures.length;
    const pad = (n: number) => String(n).padStart(2, "0");
    progressTrigger = ScrollTrigger.create({
      trigger: photosCol,
      start: "top top",
      endTrigger: lastFig,
      end: "bottom bottom",
      scroller: scroller,
      onUpdate: (self) => {
        const cur = Math.min(total, Math.max(1, Math.round(self.progress * (total - 1)) + 1));
        const label = pad(cur);
        if (progressCur.textContent !== label) progressCur.textContent = label;
      },
    });
  }

  // ---- 4) 懒加载图片尺寸稳定后刷新 ScrollTrigger（布局高度由图片实际尺寸决定，
  //        不刷新会导致进度/揭示/视差的触发位置滞后） ----
  let refreshRaf = 0;
  const imgLoadHandler = (e: Event) => {
    if (e.target instanceof HTMLImageElement) {
      cancelAnimationFrame(refreshRaf);
      refreshRaf = requestAnimationFrame(() => ScrollTrigger.refresh()); // rAF 合并连续 load
    }
  };
  scroller?.addEventListener("load", imgLoadHandler, true); // capture：img 的 load 不冒泡

  // ---- 5) 键盘滚动图片流（P1-2，保留）：方向键/翻页/Home/End ----
  const keyHandler = (e: KeyboardEvent) => {
    if (!scroller) return;
    const step = () => scroller.clientHeight * 0.8;
    switch (e.key) {
      case "ArrowDown": case "PageDown":
        e.preventDefault(); scroller.scrollBy({ top: step(), behavior: "smooth" }); break;
      case "ArrowUp": case "PageUp":
        e.preventDefault(); scroller.scrollBy({ top: -step(), behavior: "smooth" }); break;
      case "Home":
        e.preventDefault(); scroller.scrollTo({ top: 0, behavior: "smooth" }); break;
      case "End":
        e.preventDefault(); scroller.scrollTo({ top: scroller.scrollHeight, behavior: "smooth" }); break;
    }
  };
  if (desktop.matches) scroller?.addEventListener("keydown", keyHandler);

  // 手机端保持原生页面滚动；灯箱独立于桌面画册的滚动容器。
  const lightbox = document.querySelector<HTMLElement>("[data-lightbox]");
  const lightboxImg = document.querySelector<HTMLImageElement>("[data-lightbox-img]");
  const lightboxCount = document.querySelector<HTMLElement>("[data-lightbox-count]");
  const lightboxClose = document.querySelector<HTMLButtonElement>("[data-lightbox-close]");
  const lightboxPrev = document.querySelector<HTMLButtonElement>("[data-lightbox-prev]");
  const lightboxNext = document.querySelector<HTMLButtonElement>("[data-lightbox-next]");
  let activePhoto = 0;
  let returnFocus: HTMLElement | null = null;
  const updateLightbox = () => {
    const photo = figures[activePhoto]?.querySelector<HTMLImageElement>(".gallery-img");
    if (!photo || !lightboxImg || !lightboxCount) return;
    lightboxImg.src = photo.currentSrc || photo.src;
    lightboxImg.alt = photo.alt;
    lightboxCount.textContent = `${String(activePhoto + 1).padStart(2, "0")} / ${String(figures.length).padStart(2, "0")}`;
    if (lightboxPrev) lightboxPrev.disabled = activePhoto === 0;
    if (lightboxNext) lightboxNext.disabled = activePhoto === figures.length - 1;
  };
  const openLightbox = (index: number, trigger: HTMLElement) => {
    if (!lightbox || !lightboxImg) return;
    activePhoto = index;
    returnFocus = trigger;
    updateLightbox();
    lightbox.inert = false;
    lightbox.setAttribute("aria-hidden", "false");
    lightbox.classList.add("is-open");
    document.documentElement.classList.add("detail-lightbox-open");
    document.body.classList.add("detail-lightbox-open");
    lightboxClose?.focus();
  };
  const closeLightbox = () => {
    if (!lightbox || !lightboxImg) return;
    lightbox.classList.remove("is-open");
    lightbox.setAttribute("aria-hidden", "true");
    lightbox.inert = true;
    lightboxImg.removeAttribute("src");
    document.documentElement.classList.remove("detail-lightbox-open");
    document.body.classList.remove("detail-lightbox-open");
    returnFocus?.focus();
  };
  const stepLightbox = (step: number) => {
    activePhoto = Math.max(0, Math.min(figures.length - 1, activePhoto + step));
    updateLightbox();
  };
  figures.forEach((figure, index) => {
    figure.addEventListener("click", () => openLightbox(index, figure as HTMLElement));
    figure.addEventListener("keydown", (event) => {
      if (event instanceof KeyboardEvent && (event.key === "Enter" || event.key === " ")) {
        event.preventDefault();
        openLightbox(index, figure as HTMLElement);
      }
    });
  });
  lightboxClose?.addEventListener("click", closeLightbox);
  lightboxPrev?.addEventListener("click", () => stepLightbox(-1));
  lightboxNext?.addEventListener("click", () => stepLightbox(1));
  lightbox?.addEventListener("click", (event) => { if (event.target === lightbox) closeLightbox(); });
  const lightboxKeys = (event: KeyboardEvent) => {
    if (!lightbox?.classList.contains("is-open")) return;
    if (event.key === "Escape") closeLightbox();
    if (event.key === "ArrowLeft") stepLightbox(-1);
    if (event.key === "ArrowRight") stepLightbox(1);
    if (event.key === "Tab") {
      const controls = [lightboxClose, lightboxPrev, lightboxNext].filter((el): el is HTMLButtonElement => !!el && !el.disabled);
      const current = controls.indexOf(document.activeElement as HTMLButtonElement);
      if (event.shiftKey && current <= 0) { event.preventDefault(); controls.at(-1)?.focus(); }
      else if (!event.shiftKey && current === controls.length - 1) { event.preventDefault(); controls[0]?.focus(); }
    }
  };
  document.addEventListener("keydown", lightboxKeys);

  // ---- 5) 前后切换 / 关闭 / CTA：GSAP 过渡后跳转 ----
  function go(url: string, dir: "left" | "right" | "up") {
    if (!sheet || reduceMotion) { location.href = url; return; }
    gsap.to(sheet, {
      x: dir === "left" ? -80 : dir === "right" ? 80 : 0,
      y: dir === "up" ? -48 : 0,
      opacity: 0,
      duration: 0.38,
      ease: "power2.in",
      onComplete: () => { location.href = url; },
    });
  }
  document.querySelectorAll("[data-nav]").forEach((el) => {
    el.addEventListener("click", (e) => {
      e.preventDefault();
      const href = el.getAttribute("href");
      if (href) go(href, el.dataset.dir as "left" | "right");
    });
  });
  document.querySelectorAll("[data-close]").forEach((el) => {
    el.addEventListener("click", (e) => {
      e.preventDefault();
      go("/", "up");
    });
  });

  // ---- 6) 动画资源清理（AGENTS.md） ----
  function cleanup() {
    closeLightbox();
    mm.revert();
    progressTrigger?.kill();
    ScrollTrigger.getAll().forEach((t) => t.kill());
    cancelAnimationFrame(refreshRaf);
    scroller?.removeEventListener("keydown", keyHandler);
    scroller?.removeEventListener("load", imgLoadHandler, true);
    document.removeEventListener("keydown", lightboxKeys);
  }
  window.addEventListener("pagehide", cleanup, { once: true });
  window.addEventListener("beforeunload", cleanup, { once: true });
</script>
