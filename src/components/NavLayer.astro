---
// 全局悬浮导航层：左上站名、右上 Profile、底部提示——低调小字，不干扰视觉（AGENTS.md §5 UI 低调原则）
// 底部提示随指针类型切换（与放映台交互一致）：桌面「拖拽 · Shift+滚轮 横向浏览」/ 触屏「左右滑动 横向浏览」
---
<div class="nav-layer pointer-events-none absolute inset-x-0 top-0 z-40 flex flex-col justify-between px-5 py-3 text-white sm:fixed sm:inset-0 sm:px-10 sm:py-6">
  <div class="flex items-start justify-between">
    <a href="/" class="label pointer-events-auto inline-flex min-h-11 items-center opacity-80 transition-opacity duration-300 hover:opacity-100">HAN</a>
    <nav class="pointer-events-auto flex items-center gap-4 sm:hidden" aria-label="页面导航">
      <a href="#albums" class="label inline-flex min-h-11 items-center">目录</a>
      <a href="#about" class="label inline-flex min-h-11 items-center">关于</a>
    </nav>
    <button type="button" class="label pointer-events-auto hidden opacity-80 transition-opacity duration-300 hover:opacity-100 sm:inline-flex sm:min-h-11 sm:items-center" data-profile-open>Profile</button>
  </div>
  <div class="hidden justify-center sm:flex sm:justify-start">
    <p class="label text-fog" data-hint>拖拽 · Shift+滚轮 横向浏览</p>
  </div>
</div>

<script>
  // Profile 开关：只派发事件，动画由 ProfileOverlay 统一处理（M2）
  const openBtn = document.querySelector("[data-profile-open]");
  openBtn?.addEventListener("click", () => {
    window.dispatchEvent(new CustomEvent("profile:toggle"));
  });

  // 底部交互提示：随指针类型切换（text-fog 保证对比度 ≥4.5:1，替代原 opacity-30 的 ≈2.2:1）
  const hint = document.querySelector("[data-hint]");
  const pointerMq = window.matchMedia("(pointer: coarse)");
  const updateHint = () => {
    if (!hint) return;
    hint.textContent = pointerMq.matches ? "左右滑动 横向浏览" : "拖拽 · Shift+滚轮 横向浏览";
  };
  updateHint();
  pointerMq.addEventListener("change", updateHint);
</script>

<style>
  @media (max-width: 639px) {
    .nav-layer {
      padding-top: max(0.75rem, env(safe-area-inset-top));
      padding-inline: max(1.25rem, env(safe-area-inset-left)) max(1.25rem, env(safe-area-inset-right));
    }
  }
</style>
